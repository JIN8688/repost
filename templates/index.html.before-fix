            'debug_mode': true,  // 디버그 모드 (콘솔에서 확인 가능)
            'send_page_view': true  // 페이지뷰 자동 전송
        });
        
        // GA4 로딩 확인
        console.log('✅ GA4 초기화 완료: G-PWN8T3SZVW');
        
        // 즉시 테스트 이벤트 전송
        gtag('event', 'page_load', {
            'event_category': 'engagement',
