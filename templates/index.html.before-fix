    <!-- 구조화된 데이터 (JSON-LD) for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "리포스트",
      "alternateName": "Repost",
      "url": "https://repost.kr",
      "logo": "{{ url_for('static', filename='images/logo-og.png', _external=True) }}",
      "description": "AI 기반 블로그 댓글 자동 추천 서비스. 네이버 블로그 링크를 넣으면 자동으로 적절한 댓글을 생성해드립니다.",
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Any",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "KRW"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "127"
      },
      "author": {
        "@type": "Organization",
        "name": "Repost",
        "url": "https://repost.kr"
      },
      "inLanguage": "ko-KR",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://repost.kr/?url={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <!-- 🎨 Header (헤더) -->
    <header style="position: fixed; top: 0; left: 0; right: 0; z-index: 1000; background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(0, 0, 0, 0.1); box-shadow: 0 2px 20px rgba(0, 0, 0, 0.05);">
